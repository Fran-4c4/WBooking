Imports Microsoft.VisualBasic

Namespace cfr

    Public Class languagePageManager
        Inherits Language

        ''' <summary>
        ''' property type for loading diferent language
        ''' </summary>
        ''' <remarks></remarks>
        Public holdproperty As cfr.CFRConst.unitTypeEnum = CFRConst.unitTypeEnum.hotel


        Public Shadows Function GetCaptionBy(ByVal key As cfr.Language.msgEnum) As String
            Return cfr.Language.GetCaption(key)
        End Function

        ''' <summary>
        ''' Return the string for selected id
        ''' </summary>
        ''' <param name="key"></param>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shadows Function GetCaption(ByVal key As String) As String
            Dim l As Language = cfr.Language.CacheLang(Language.CurrentCulture.Name)
            If Me.holdproperty = CFRConst.unitTypeEnum.car Then
                l = cfr.Language.CacheLang(Language.CurrentCulture.Name & "-" & CFRConst.unitTypeEnum.car)
            End If

            Return l.getValue(key)
        End Function


    End Class


    ''' <summary>
    ''' Class to control text for language
    ''' </summary>
    ''' <remarks></remarks>
    Public Class Language
        Public idi(400) As String

        Private Shared cache As Hashtable
        ''' <summary>
        ''' subset language for property. Samen number as holder property type
        ''' </summary>
        ''' <remarks></remarks>
        Public Enum langSSEnum As Byte
            bydefault = 0
            hotel = cfr.CFRConst.unitTypeEnum.hotel
            car = cfr.CFRConst.unitTypeEnum.car
        End Enum

        Public Shared ReadOnly Property CacheLang() As Hashtable
            Get
                If cfr.Language.cache Is Nothing Then
                    cfr.Language.ConfigCache()
                End If
                Return cfr.Language.cache
            End Get

        End Property


#Region "methods"
        ''' <summary>
        ''' configure culture
        ''' </summary>
        ''' <param name="language"></param>
        ''' <remarks></remarks>
        Public Shared Sub ConfigCulture(ByVal language As cfr.CFRConst.LanguageEnum)
            Select Case language
                Case cfr.CFRConst.LanguageEnum.es
                    System.Threading.Thread.CurrentThread.CurrentCulture = New System.Globalization.CultureInfo("es-ES")
                Case cfr.CFRConst.LanguageEnum.en
                    System.Threading.Thread.CurrentThread.CurrentCulture = New System.Globalization.CultureInfo("en-US")
                Case cfr.CFRConst.LanguageEnum.de
                    System.Threading.Thread.CurrentThread.CurrentCulture = New System.Globalization.CultureInfo("de-DE")
                Case cfr.CFRConst.LanguageEnum.fr
                    System.Threading.Thread.CurrentThread.CurrentCulture = New System.Globalization.CultureInfo("fr-FR")
            End Select
        End Sub

        Friend Function getValue(ByVal key As String) As String
            Return Me.idi(key)
        End Function
        ''' <summary>
        ''' configure cache with english and spanish
        ''' </summary>
        ''' <remarks></remarks>
        Private Shared Sub ConfigCache()
            cfr.Language.cache = New Hashtable

            AddLanguage("es-ES", cfr.CFRConst.LanguageEnum.es)
            AddLanguage("en-US", cfr.CFRConst.LanguageEnum.en)
            AddLanguage("de-DE", cfr.CFRConst.LanguageEnum.de)
            AddLanguage("fr-FR", cfr.CFRConst.LanguageEnum.fr)
            AddLanguage("es-ES-" & cfr.CFRConst.unitTypeEnum.car, cfr.CFRConst.LanguageEnum.es, CFRConst.unitTypeEnum.car)
            AddLanguage("en-US-" & cfr.CFRConst.unitTypeEnum.car, cfr.CFRConst.LanguageEnum.en, CFRConst.unitTypeEnum.car)
            AddLanguage("de-DE-" & cfr.CFRConst.unitTypeEnum.car, cfr.CFRConst.LanguageEnum.de, CFRConst.unitTypeEnum.car)
            AddLanguage("fr-FR-" & cfr.CFRConst.unitTypeEnum.car, cfr.CFRConst.LanguageEnum.fr, CFRConst.unitTypeEnum.car)
        End Sub

        Private Shared Sub AddLanguage(langKey As String, langEnum As cfr.CFRConst.LanguageEnum, Optional unitType As cfr.CFRConst.unitTypeEnum = CFRConst.unitTypeEnum.hotel)
            Dim langObj As New cfr.Language
            If unitType = CFRConst.unitTypeEnum.hotel Then
                langObj.LoadLanguage(langEnum)
            Else
                langObj.LoadLanguageCar(langEnum)
            End If

            cfr.Language.cache.Add(langKey, langObj)
        End Sub

        ''' <summary>
        ''' return the current culture used name
        ''' </summary>
        ''' <value></value>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared ReadOnly Property CurrentCultureName() As String
            Get
                Return System.Threading.Thread.CurrentThread.CurrentCulture.Name
            End Get
        End Property

        ''' <summary>
        ''' return the current culture used object
        ''' </summary>
        ''' <value></value>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared ReadOnly Property CurrentCulture() As System.Globalization.CultureInfo
            Get
                Return System.Threading.Thread.CurrentThread.CurrentCulture
            End Get
        End Property

        ''' <summary>
        ''' return language selected
        ''' </summary>
        ''' <value></value>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Shared ReadOnly Property getLanguage() As cfr.CFRConst.LanguageEnum
            Get
                Dim ci As System.Globalization.CultureInfo = Language.CurrentCulture
                If ci.Name = "es-ES" Then
                    Return CFRConst.LanguageEnum.es
                ElseIf ci.Name = "en-US" Then
                    Return CFRConst.LanguageEnum.en
                ElseIf ci.Name = "de-DE" Then
                    Return CFRConst.LanguageEnum.de
                ElseIf ci.Name = "fr-FR" Then
                    Return CFRConst.LanguageEnum.fr
                Else
                    Return CFRConst.LanguageEnum.en
                End If
            End Get
        End Property
#End Region

#Region "Months"
        Public Shared Function getMonthName(day2 As Date) As String
            Select Case Month(day2)
                Case 1
                    Return cfr.Language.GetCaption(230)
                Case 2
                    Return cfr.Language.GetCaption(231)
                Case 3
                    Return cfr.Language.GetCaption(232)
                Case 4
                    Return cfr.Language.GetCaption(233) '
                Case 5
                    Return cfr.Language.GetCaption(234) ' "Mayo"
                Case 6
                    Return cfr.Language.GetCaption(235) ' "Junio"
                Case 7
                    Return cfr.Language.GetCaption(236) ' "Julio"
                Case 8
                    Return cfr.Language.GetCaption(237) ' "Agosto"
                Case 9
                    Return cfr.Language.GetCaption(238) ' "Septiembre"
                Case 10
                    Return cfr.Language.GetCaption(239) ' "Octubre"
                Case 11
                    Return cfr.Language.GetCaption(240) ' "Noviembre"
                Case 12
                    Return cfr.Language.GetCaption(241) ' "Diciembre"
            End Select
            Return String.Empty
        End Function

        Public Shared Function getWeekDayName(day2 As Date) As String
            Select Case Weekday(day2, vbMonday)
                Case 1
                    Return cfr.Language.GetCaption(242) 'monday
                Case 2
                    Return cfr.Language.GetCaption(243)
                Case 3
                    Return cfr.Language.GetCaption(244)
                Case 4
                    Return cfr.Language.GetCaption(245) '
                Case 5
                    Return cfr.Language.GetCaption(246) ' "friday"
                Case 6
                    Return cfr.Language.GetCaption(247) ' "saturday"
                Case 7
                    Return cfr.Language.GetCaption(248) ' "sunday"

            End Select
            Return String.Empty
        End Function
#End Region



