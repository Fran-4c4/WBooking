<%@ Master Language="VB" CodeFile="blank.master.vb" Inherits="blank" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <title><asp:literal id="masterPageTitleLiteral" runat="Server"></asp:literal></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta content="text/html; charset=iso-8859-1" http-equiv="content-type" title="booking system" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Francisco Moreno Santana">
    <%--<meta http-equiv="cache-control" content="max-age=0" />--%>
    
    <!-- Bootstrap theme -->
    <link rel="stylesheet" href="vendor/bootstrap-3.2.0/css/bootstrap.min.css">
	<%--<link href="~/css/bootstrap.css" rel="stylesheet" type="text/css" />--%>
    <link rel="stylesheet" href="vendor/font-awesome-4.5.0/css/font-awesome.min.css">

    <!-- styles master -->
    <link href="~/css/messages.css" rel="stylesheet" type="text/css"  >
    <link href="~/css/mp-booking.css" rel="stylesheet" type="text/css"  > 
    <!-- literales -->  
    <asp:Literal id="StyleSheetLiteral" runat="Server" ></asp:literal>
    <asp:literal id="StyleSheetLiteralBooking" runat="Server"></asp:literal>

    <!-- styles master -->
    

    
    <script language="JavaScript" src="js/showdata1.js" type="text/javascript"></script>  

    <asp:ContentPlaceHolder ID="HeadContentPlaceHolder" runat="server"/>
    
    <asp:ContentPlaceHolder runat="server" ID="HeadScript" />

    <style >
        body {
          margin-top: 0px !important;
        }
    </style>
</head>
<body id="home" data-spy="scroll">
     <form id="formMaster" runat="server">
         <asp:ScriptManager ID="ScriptManagerMP" runat="server"></asp:ScriptManager>
                <!-- BEGIN CONTENT -->
                    
                   
                     <asp:UpdatePanel ID="UpdatePanel1error" runat="server">
                <ContentTemplate>
                    <asp:Literal ID="litMsgErr" runat="server" Visible="true" ClientIDMode="static"></asp:Literal>
                </ContentTemplate>
            </asp:UpdatePanel>

                    <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        
                    </asp:ContentPlaceHolder>
                   
                <!-- END CONTENT -->

        <asp:PlaceHolder ID="PlaceHolderBootStrapJS" runat="server">
        <!--Bootstrap core JavaScript ================ -->
        <!-- Placed at the end of the document so the pages load faster -->
        <script src="vendor/jquery-1.11.1/jquery.min.js"></script>
        <!-- Latest compiled JavaScript -->
        <script src="vendor/bootstrap-3.2.0/js/bootstrap.js"></script>
        <%--<script src="./js/bootstrap.js"></script>--%>
        <script src="./js/customui.js"></script>

    </asp:PlaceHolder>

    <asp:ContentPlaceHolder runat="server" ID="bottomScriptPlaceHolder" />
         </form>
</body>
</html>
