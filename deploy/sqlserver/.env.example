# Runtime contract for docker-compose.sqlserver.yml and the local scripts.
# WBOOKING_SQL_PORT is the host TCP port. It must be free and in 1..65535.
WBOOKING_SQL_PORT=14333

# Both passwords are required. Do not use these placeholders or commit real values.
# The initialization script generates strong local values in .local/sqlserver/.env.
WBOOKING_SQL_SA_PASSWORD=CHANGE_ME
WBOOKING_SQL_APP_PASSWORD=CHANGE_ME
